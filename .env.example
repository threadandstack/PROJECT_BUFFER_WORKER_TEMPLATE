# Buffer Worker — environment variables (names only; set real values with
# `ntn workers env set NAME=value`, never commit them).

# --- Required ---
# Buffer personal API token — publish.buffer.com/settings/api
BUFFER_ACCESS_TOKEN=
# Buffer organisation id (see the client's Buffer account, or `ntn workers exec listChannels`)
BUFFER_ORG_ID=
# Notion internal integration token, shared with the client's three databases
NOTION_API_TOKEN=

# --- Set after setup ---
# Printed by `ntn workers exec setupClient` once it creates the Publishing DB
BUFFER_PUBLISHING_DATA_SOURCE_ID=
# The Buffer Analytics data source (worker-created on first deploy; find via showDatabases)
BUFFER_ANALYTICS_DATA_SOURCE_ID=

# --- Optional: media re-hosting via Google Drive ---
# A Google Cloud OAuth app with the Drive API enabled. Without these, posts still
# publish — attachments in "Post's Media" are just skipped with a note.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
